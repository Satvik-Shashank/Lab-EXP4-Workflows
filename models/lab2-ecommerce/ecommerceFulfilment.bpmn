<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_shop" targetNamespace="https://example.edu/camunda/labs" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="ecommerceFulfilment" name="Lab 2 - E-Commerce Order Processing" isExecutable="true">
    <bpmn:startEvent id="Start" name="Order received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ValidateOrder" name="Validate order and calculate total (Java worker)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ValidGateway" name="Order valid?" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InventoryREST" name="REST Connector - Check inventory" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8081/api/inventory/check" target="url" />
          <zeebe:input source="= {&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ productId: productId, quantity: quantity }" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="inventoryResponse" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponseBody: response.body&#10;  // Use FEEL to extract values, e.g.,:&#10;  // myUserId: response.body.post.userId&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="StockGateway" name="Stock available?" default="f7">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PaymentREST" name="REST Connector - Mock payment gateway" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8081/api/payment" target="url" />
          <zeebe:input source="= {&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="= { paymentToken: paymentToken }" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="paymentResponse" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponseBody: response.body&#10;  // Use FEEL to extract values, e.g.,:&#10;  // myUserId: response.body.post.userId&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PaymentGateway" name="Payment successful?" default="f10">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="PriorityDMN" name="Evaluate order priority DMN">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="orderPriority" resultVariable="decisionResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="PriorityGateway" name="Priority routing" default="f13">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="HighValueReview" name="Tasklist - high-value order verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ReviewEnd" name="Verified for fulfilment">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FulfilTask" name="Mark order ready for fulfilment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-fulfilment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FulfilledEnd" name="Ready for fulfilment">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ExceptionReview" name="Tasklist - order exception review">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ExceptionEnd" name="Order held for review">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="ValidateOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="ValidateOrder" targetRef="ValidGateway" />
    <bpmn:sequenceFlow id="f3" sourceRef="ValidGateway" targetRef="InventoryREST">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="ValidGateway" targetRef="ExceptionReview" />
    <bpmn:sequenceFlow id="f5" sourceRef="InventoryREST" targetRef="StockGateway" />
    <bpmn:sequenceFlow id="f6" sourceRef="StockGateway" targetRef="PaymentREST">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inventoryResponse.body.available = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" sourceRef="StockGateway" targetRef="ExceptionReview" />
    <bpmn:sequenceFlow id="f8" sourceRef="PaymentREST" targetRef="PaymentGateway" />
    <bpmn:sequenceFlow id="f9" sourceRef="PaymentGateway" targetRef="PriorityDMN">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentResponse.body.status = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="PaymentGateway" targetRef="ExceptionReview" />
    <bpmn:sequenceFlow id="f11" sourceRef="PriorityDMN" targetRef="PriorityGateway" />
    <bpmn:sequenceFlow id="f12" sourceRef="PriorityGateway" targetRef="HighValueReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decisionResult.priority = "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" sourceRef="PriorityGateway" targetRef="FulfilTask" />
    <bpmn:sequenceFlow id="f14" sourceRef="HighValueReview" targetRef="ReviewEnd" />
    <bpmn:sequenceFlow id="f15" sourceRef="FulfilTask" targetRef="FulfilledEnd" />
    <bpmn:sequenceFlow id="f16" sourceRef="ExceptionReview" targetRef="ExceptionEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ecommerceFulfilment">
    <bpmndi:BPMNPlane id="Plane_ecommerceFulfilment" bpmnElement="ecommerceFulfilment">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="170" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="152" y="256" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateOrder_di" bpmnElement="ValidateOrder">
        <dc:Bounds x="270" y="200" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidGateway_di" bpmnElement="ValidGateway" isMarkerVisible="true">
        <dc:Bounds x="440" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="435" y="191" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InventoryREST_di" bpmnElement="InventoryREST">
        <dc:Bounds x="550" y="200" width="125" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StockGateway_di" bpmnElement="StockGateway" isMarkerVisible="true">
        <dc:Bounds x="740" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="725" y="265" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentREST_di" bpmnElement="PaymentREST">
        <dc:Bounds x="850" y="200" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentGateway_di" bpmnElement="PaymentGateway" isMarkerVisible="true">
        <dc:Bounds x="1040" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1036" y="177.5" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PriorityDMN_di" bpmnElement="PriorityDMN">
        <dc:Bounds x="1150" y="200" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PriorityGateway_di" bpmnElement="PriorityGateway" isMarkerVisible="true">
        <dc:Bounds x="1320" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1379.5" y="233" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HighValueReview_di" bpmnElement="HighValueReview">
        <dc:Bounds x="1480" y="80" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewEnd_di" bpmnElement="ReviewEnd">
        <dc:Bounds x="1670" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1662" y="138" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExceptionReview_di" bpmnElement="ExceptionReview">
        <dc:Bounds x="877" y="380" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExceptionEnd_di" bpmnElement="ExceptionEnd">
        <dc:Bounds x="1102" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1086" y="438" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FulfilTask_di" bpmnElement="FulfilTask">
        <dc:Bounds x="1480" y="270" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FulfilledEnd_di" bpmnElement="FulfilledEnd">
        <dc:Bounds x="1670" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1664" y="336" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="206" y="238" />
        <di:waypoint x="270" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="395" y="240" />
        <di:waypoint x="440" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="490" y="240" />
        <di:waypoint x="550" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="465" y="265" />
        <di:waypoint x="465" y="455" />
        <di:waypoint x="878" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="675" y="240" />
        <di:waypoint x="740" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="790" y="240" />
        <di:waypoint x="850" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="790" y="240" />
        <di:waypoint x="790" y="420" />
        <di:waypoint x="877" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="975" y="240" />
        <di:waypoint x="1040" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1090" y="240" />
        <di:waypoint x="1150" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1065" y="265" />
        <di:waypoint x="1065" y="400" />
        <di:waypoint x="1002" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1275" y="240" />
        <di:waypoint x="1320" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1345" y="215" />
        <di:waypoint x="1345" y="120" />
        <di:waypoint x="1480" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1345" y="265" />
        <di:waypoint x="1345" y="327" />
        <di:waypoint x="1480" y="327" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14">
        <di:waypoint x="1605" y="120" />
        <di:waypoint x="1670" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15">
        <di:waypoint x="1605" y="310" />
        <di:waypoint x="1670" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16">
        <di:waypoint x="1002" y="420" />
        <di:waypoint x="1102" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
