<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_orderPriority" name="E-Commerce Order Processing DMN" namespace="https://example.edu/camunda/labs">
 <decision id="orderPriority" name="E-Commerce Order Processing DMN">
  <decisionTable id="DecisionTable_orderPriority" hitPolicy="FIRST">
   <input id="Input_1" label="orderTotal"><inputExpression id="InputExpression_1" typeRef="number"><text>orderTotal</text></inputExpression></input><input id="Input_2" label="customerCategory"><inputExpression id="InputExpression_2" typeRef="string"><text>customerCategory</text></inputExpression></input><input id="Input_3" label="deliveryPreference"><inputExpression id="InputExpression_3" typeRef="string"><text>deliveryPreference</text></inputExpression></input><output id="Output_1" name="priority" typeRef="string"/><rule id="Rule_1"><description>HIGH</description><inputEntry id="IE_1_1"><text>&gt;= 20000</text></inputEntry><inputEntry id="IE_1_2"><text>-</text></inputEntry><inputEntry id="IE_1_3"><text>-</text></inputEntry><outputEntry id="OE_1"><text>"HIGH"</text></outputEntry></rule><rule id="Rule_2"><description>HIGH</description><inputEntry id="IE_2_1"><text>-</text></inputEntry><inputEntry id="IE_2_2"><text>"VIP"</text></inputEntry><inputEntry id="IE_2_3"><text>&quot;EXPRESS&quot;</text></inputEntry><outputEntry id="OE_2"><text>"HIGH"</text></outputEntry></rule><rule id="Rule_3"><description>MEDIUM</description><inputEntry id="IE_3_1"><text>-</text></inputEntry><inputEntry id="IE_3_2"><text>-</text></inputEntry><inputEntry id="IE_3_3"><text>"EXPRESS"</text></inputEntry><outputEntry id="OE_3"><text>"MEDIUM"</text></outputEntry></rule><rule id="Rule_4"><description>NORMAL</description><inputEntry id="IE_4_1"><text>-</text></inputEntry><inputEntry id="IE_4_2"><text>-</text></inputEntry><inputEntry id="IE_4_3"><text>-</text></inputEntry><outputEntry id="OE_4"><text>"NORMAL"</text></outputEntry></rule>
  </decisionTable>
 </decision>
</definitions>